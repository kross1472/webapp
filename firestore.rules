rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // DENY-ALL GLOBAL
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '')
            in ['admin', 'physiotherapist', 'receptionist'])
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
            in ['admin', 'physiotherapist', 'receptionist'])
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') == 'admin')
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isPhysio() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') == 'physiotherapist')
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'physiotherapist')
      );
    }

    function isReceptionist() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') == 'receptionist')
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'receptionist')
      );
    }

    // -------------------------------------------------------------------------
    // 1. STAFF USERS
    // Solo admins pueden crear, editar y eliminar staff
    // Cualquier usuario autenticado puede leer (para buscar fisios disponibles etc)
    // -------------------------------------------------------------------------
    match /staff_users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. USERS (pacientes / clientes)
    // Solo admin puede crear y eliminar
    // El propio usuario puede editar su documento EXCEPTO el campo role
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId || isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. PACIENTES E HISTORIAS CLÍNICAS
    // Todo el staff puede gestionar pacientes
    // Historias clínicas solo admin y fisioterapeuta
    // -------------------------------------------------------------------------
    match /patients/{patientId} {
      allow read, write: if isStaff();

      match /clinical_histories/{historyId} {
        allow read, write: if isAdmin() || isPhysio();
      }
    }

    // -------------------------------------------------------------------------
    // 4. CITAS
    // Cualquiera puede ver disponibilidad y crear citas
    // Solo staff puede modificar o eliminar
    // Detalles de cita (PII) solo staff puede leer
    // -------------------------------------------------------------------------
    match /appointments/{appointmentId} {
      allow read, create: if true;
      allow update, delete: if isStaff();

      match /details/{detailId} {
        allow create: if true;
        allow read, update, delete: if isStaff();
      }
    }

    // -------------------------------------------------------------------------
    // 5. CONTENIDO PÚBLICO
    // Admins y recepcionistas pueden administrar
    // -------------------------------------------------------------------------
    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isReceptionist();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isReceptionist();
    }

    match /gallery_centro/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isReceptionist();
    }

    match /availability/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // -------------------------------------------------------------------------
    // 6. CORREOS / CONTACTO
    // Público puede enviar con validación mínima anti-spam
    // Solo staff puede leer, modificar o eliminar
    // -------------------------------------------------------------------------
    match /mail/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message']) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isStaff();
    }
  }
}
