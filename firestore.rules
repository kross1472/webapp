rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperUser() {
      return isSignedIn() && 
        request.auth.token != null && 
        (
          request.auth.token.get('email', '').matches('(?i)^cristhian\\.a\\.carrera@gmail\\.com$') ||
          request.auth.token.get('email', '').matches('(?i)^admin@prophysical\\.com$')
        );
    }

    function isAdrian() {
      return isSignedIn() && (
        request.auth.uid == '25sYFGzeJDXr3ygUseMSDd2ru2j2' ||
        (
          request.auth.token != null && 
          request.auth.token.get('email', '').matches('(?i)^adrianalexandertoaingazuniga@gmail\\.com$')
        )
      );
    }
    
    function isStaff() {
      return isSignedIn() && (
        isSuperUser() ||
        isAdrian() ||
        (
          exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') in ['admin', 'physiotherapist', 'receptionist']
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'physiotherapist', 'receptionist']
        )
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isSuperUser() ||
        (
          exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        )
      );
    }
    
    function isPhysio() {
      return isSignedIn() && (
        isAdrian() ||
        (
          exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') == 'physiotherapist'
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'physiotherapist'
        )
      );
    }
    
    function isReceptionist() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.get('role', '') == 'receptionist'
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'receptionist'
        )
      );
    }

    function isStaffMigration(userId) {
      return isSignedIn() &&
        userId == request.auth.uid &&
        request.resource.data != null &&
        (
          isAdrian() ||
          (
            request.auth.token != null &&
            request.auth.token.get('email', '') != '' &&
            request.resource.data.keys().hasAll(['username']) &&
            request.resource.data.username != '' && 
            exists(/databases/$(database)/documents/staff_users/$(request.resource.data.username)) &&
            request.auth.token.get('email', '') == get(/databases/$(database)/documents/staff_users/$(request.resource.data.username)).data.get('email', '') &&
            request.resource.data.keys().hasAll(['role']) &&
            request.resource.data.role == get(/databases/$(database)/documents/staff_users/$(request.resource.data.username)).data.get('role', '')
          )
        );
    }
    
    // 1. Staff Profiles & Credentials
    match /staff_users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isReceptionist() || (isSignedIn() && userId == request.auth.uid && isStaffMigration(userId));
    }
    
    // 2. Base Users Details
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    
    // 3. Patients Records
    match /patients/{patientId} {
      // All clinic staff can view patient directory/demographics
      allow read, write: if isStaff();
      
      // Clinical histories are highly personal: restricted to medical personnel
      match /clinical_histories/{historyId} {
        allow read, write: if isAdmin() || isPhysio();
      }
    }
    
    // 4. Appointments Scheduler
    match /appointments/{appointmentId} {
      // Anyone can see available times and request booking
      allow read, create: if true;
      // Modifying or canceling appointments requires staff permission
      allow update, delete: if isStaff();
      
      match /details/{detailId} {
        // Anyone can create booking details during request creation
        allow create: if true;
        // Only staff can read, update, or delete appointment details
        allow read, update, delete: if isStaff();
      }
    }
    
    // 5. Marketing, Assets, and Configuration collections
    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isReceptionist();
    }
    
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isReceptionist();
    }
    
    match /gallery_centro/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isReceptionist();
    }
    
    match /availability/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /mail/{docId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }
  }
}
